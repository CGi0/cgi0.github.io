	---
	import BaseHead from '../components/BaseHead.astro';
	import Footer from '../components/Footer.astro';
	import Header from '../components/Header.astro';
	import Spotlight from "../components/Spotlight.astro";

	import { Image } from 'astro:assets';
	import avatarImg from '../assets/avatar.jpg';
	import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
	---

	<!doctype html>
	<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="split-page">
		<!-- 1. Two-color background columns -->
		<div class="bg-columns" aria-hidden="true">
			<Spotlight class="bg-left" color="rgba(37, 99, 235, 0.35)" size="450px" />
			<Spotlight class="bg-right" color="#ffffff" size="450px" />
		</div>

		<!-- 2. Foreground content sitting in front -->
		<div class="foreground-grid">
			<!-- Floating container overlapping the split -->
			<main class="floating-card">
				<span class="badge">Featured Info</span>
				<div class="circle-frame">
					<Image src={avatarImg} alt="Profile photo" width={240} height={240} />
				</div>
				<h2>Clarence Gio Napao</h2>
				
				<div class="card-content">
					<h5>
					BS - Computer Engineering<br> 
					Student @ DLSU
					</h5>
					<p>Personal: clarencegionapao@gmail.com <br>
						School: clarence_napao@dlsu.edu.ph <br>
						Phone: +63 956 897 9410
					</p>
				</div>
				<div class="social-links">
					<a href="https://linkedin.com/in/clarence-napao" target="_blank">
						<span class="sr-only">Follow Clarence on LinkedIn</span>
						<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
							<path
								d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037c-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85c3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451c.979 0 1.778-.773 1.778-1.729V1.729C24 .774 23.205 0 22.225 0z"
							></path>
						</svg>
					</a>
					<a href="https://github.com/cgi0" target="_blank">
						<span class="sr-only">Go to Clarence's GitHub repo</span>
						<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
							<path
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							></path>
						</svg>
					</a>
				</div>
			</main>

			<!-- Additional text inside the light-colored right column -->
			<aside class="right-column-text">
			<h2>Hello!</h2>
			<h5>Welcome to my personal website</h5>
			<p>
				I am a fourth-year Bachelor of Science in Computer Engineering student at De La Salle University – Laguna Campus.
			</p>
			<p>
				Passionate about hardware-software integration, my work and interests center on embedded systems, robotics, and edge machine learning.
			</p>
			<p>
				Beyond academics, I have also engaged in creative direction, project planning, and student leadership.
			</p>
			</aside>
		</div>
		</div>
		<Footer />
	</body>
	</html>

	<style>
	body {
		margin: 0;
	}

	.split-page {
		position: relative;
		flex: 1;
		min-height: 100vh;
		display: flex;
		align-items: center;
	}

	/* Full-screen two-color backdrop */
	.bg-columns {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: 1fr 1fr; /* 50/50 color split */
		z-index: 0;
	}

	:global(.bg-left){
		background-color: #0f172a; /* Dark color on the left */
	}

	:global(.bg-right) {
		background-color: #fbf6e2; /* Light color on the right */
	}

	/* Foreground layout */
	.foreground-grid {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 1140px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
		display: grid;
		/* Left track extends slightly past the 50% center seam */
		grid-template-columns: 1.15fr 0.85fr;
		gap: 4rem;
		align-items: center;
	}

	.floating-card {
		width: 100%;
		max-width: 360px;      /* Keeps the card narrow */
		min-height: 500px;     /* Forces a tall, vertical rectangle shape */
		justify-self: end;     /* Keeps the card anchored across the center color split */
		
		display: flex;
		flex-direction: column;
		align-items: center;   /* Centers content horizontally inside the vertical card */
		text-align: center;

		background: #ffffff;
		color: #1e293b;
		border: 1px solid #e2e8f0;
		border-radius: 16px;
		padding: 2.5rem 2rem;
		box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.25);

		transition:
		transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
		box-shadow 0.35s ease;
		will-change: transform;
	}

	.floating-card:hover {
		transform: scale(1.04);
		box-shadow: 0 30px 60px -12px rgba(15, 23, 42, 0.4);
	}

	.circle-frame {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		overflow: hidden;
		border: 4px solid #ffffff;
		box-shadow: 0 8px 20px rgba(15, 23, 42, 0.15);
		margin-bottom: 1.5rem;
		background-color: #e2e8f0;
	}

	.circle-frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.card-content {
		margin-top: 1.5rem;
		font-size: 1rem;
		line-height: 1.5;
		color: #475569;
	}

	.social-links,
	.social-links a {
		display: flex;
		gap: 1em;
	}

	@media (max-width: 720px) {
		.social-links {
			display: none;
			color: #475569;
		}
	}

	.badge {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #2563eb;
		background: #eff6ff;
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		margin-bottom: 0.75rem;
	}

	.right-column-text {
		color: #334155;
		font-size: 1.25rem;
	}

	.right-column-text h2 {
		color: #0f172a;
		margin-top: 0;
	}

	/* Stack cleanly on mobile screens */
	@media (max-width: 820px) {
    .bg-columns {
      grid-template-columns: 1fr;
      grid-template-rows: 260px 1fr;
    }

    .foreground-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 4rem;
    }

    .floating-card {
      justify-self: center; /* Centers the vertical card on mobile */
      min-height: 440px;
    }
	@media (prefers-reduced-motion: reduce) {
	.floating-card {
		transition: none;
	}
	.floating-card:hover {
		transform: none;
	}

  }
	</style>