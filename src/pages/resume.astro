	---
	import BaseHead from '../components/BaseHead.astro';
	import Footer from '../components/Footer.astro';
	import Header from '../components/Header.astro';
    import Spotlight from "../components/Spotlight.astro";
	import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

    const pdfUrl = "/Napao, Clarence Gio_Resume.pdf";
	---

    <!doctype html>
    <html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header />
        <div class="background-container">
            <div class="glow-layer" aria-hidden="true">
                <Spotlight color="rgba(37, 99, 235, 0.35)"size="400px" />
            </div>

            <main class="resume-page">
                <div class="resume-container">
                    <div class="resume-header">
                        <div>
                            <h1>Resume</h1>
                            <p>View inline below or save a copy for your records.</p>
                        </div>

                        <div class="resume-actions">
                            <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="btn-outline">
                            Open in New Tab ↗
                            </a>
                            <a href={pdfUrl} download="Resume.pdf" class="btn-primary">
                            Download PDF ↓
                            </a>
                        </div>
                    </div>
                    <div class="pdf-viewer">
                        <object
                            title="Resume PDF"
                            aria-label="Resume PDF"
                            aria-labelledby="resume-actions"
                            data={`${pdfUrl}#view=FitH`}
                            type="application/pdf"
                            class="pdf-embed"
                            aria-label="Resume PDF"
                        >
                            <!-- Fallback for mobile browsers that do not render inline PDFs -->
                            <div class="pdf-fallback">
                                <p>Inline PDF preview isn't supported on this device.</p>
                                <a href={pdfUrl} download="Resume.pdf" class="btn-primary">
                                    Download Resume (PDF)
                                </a>
                            </div>
                        </object>
                    </div>
                </div>
            </main>
        </div>
        <Footer />
    </body>
    </html>

    <style>
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  
  .background-container {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #0f172a;
  }

  .background-container:has(.pdf-viewer:hover) .glow-layer {
  opacity: 0;
    }

  .glow-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    }

    .glow-layer :global(.spotlight) {
        height: 100%;
    }

  .resume-page {
    flex: 1;
    z-index: 1;
    padding: 2.5rem 1.5rem;
  }

  .resume-container {
    max-width: 960px;
    margin: 0 auto;
  }

  .resume-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .resume-header h1 {
    margin: 0 0 0.25rem;
    color: #ffffff;
  }

  .resume-header p {
    margin: 0;
    color: #ffffff;
  }

  .resume-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-outline {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .btn-primary {
    background-color: #2563eb;
    color: #ffffff;
  }

  .btn-primary:hover {
    background-color: #1d4ed8;
  }

  .btn-outline {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cbd5e1;
  }

  .btn-outline:hover {
    border-color: #94a3b8;
    background-color: #f1f5f9;
  }

  .pdf-viewer {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
  }

  .pdf-embed {
    display: block;
    width: 100%;
    height: 80vh;
    min-height: 620px;
    border: none;
  }

  .pdf-fallback {
    padding: 4rem 1.5rem;
    text-align: center;
    color: #334155;
  }

  @media (max-width: 640px) {
    .pdf-embed {
      height: 500px;
      min-height: auto;
    }
  }
</style>