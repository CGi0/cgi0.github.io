---
/**
 * InfoFrame — a full-width text section that grows with its content, laid out like
 * the experience section of a resume. Pair it with <ImageSlide> to describe
 * the image above it.
 *
 * Usage:
 *   <InfoFrame
 *     heading="Harbor Ridge Residences"
 *     subheading="Mixed-use development, Batangas"
 *     minHeight="100dvh"
 *     entries={[
 *       {
 *         title: "Lead Architect",
 *         organization: "Studio Alon",
 *         period: "2022 – 2025",
 *         location: "Batangas",
 *         summary: "Led design from concept to turnover.",
 *         highlights: ["Cut material cost by 12%", "Coordinated 4 consultants"],
 *         tags: ["Revit", "Site planning"],
 *       },
 *     ]}
 *   />
 *
 * There is no height limit: the frame is at least `minHeight` tall (a full
 * screen by default) and grows with its content, so it never scrolls internally.
 * Pass minHeight="auto" to size purely to content.
 */

interface Entry {
  /** Role or item title, e.g. "Lead Architect". */
  title: string;
  /** Company, client or place. */
  organization?: string;
  /** Optional link for the organization. External links open safely in a new tab. */
  href?: string;
  /** Free-form date range, e.g. "Jan 2022 – Present". */
  period: string;
  location?: string;
  /** One or two sentences of context. */
  summary?: string;
  /** Achievements or details, one per line. */
  highlights?: string[];
  /** Skills, tools or keywords. */
  tags?: string[];
}

interface Props {
  heading: string;
  subheading?: string;
  entries: Entry[];
  /** Minimum height. Default fills the viewport; the frame grows past it as needed. Use "auto" to size to content. */
  minHeight?: string | number;
  id?: string;
  class?: string;
}

const {
  heading,
  subheading,
  entries,
  minHeight = "100dvh",
  id,
  class: className,
} = Astro.props;

const frameMinHeight = typeof minHeight === "number" ? `${minHeight}px` : minHeight;
const isExternal = (url: string) => /^(https?:)?\/\//.test(url);
const headingId = `${id ?? "info-frame"}-heading`;
---

<section
  id={id}
  class:list={["info-frame", className]}
  style={`--frame-min-height: ${frameMinHeight};`}
  aria-labelledby={headingId}
>
  <div class="inner">
    <header>
      <h2 id={headingId}>{heading}</h2>
      {subheading && <p class="subheading">{subheading}</p>}
    </header>

    <ol class="entries">
      {
        entries.map((entry) => (
          <li class="entry">
            <div class="meta">
              <time>{entry.period}</time>
              {entry.location && <span class="location">{entry.location}</span>}
            </div>

            <div class="body">
              <h3>{entry.title}</h3>
              {entry.organization && (
                <p class="organization">
                  {entry.href ? (
                    <a
                      href={entry.href}
                      {...(isExternal(entry.href)
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      {entry.organization}
                      {isExternal(entry.href) && (
                        <span class="visually-hidden"> (opens in a new tab)</span>
                      )}
                    </a>
                  ) : (
                    entry.organization
                  )}
                </p>
              )}
              {entry.summary && <p class="summary">{entry.summary}</p>}

              {entry.highlights && entry.highlights.length > 0 && (
                <ul class="highlights">
                  {entry.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}

              {entry.tags && entry.tags.length > 0 && (
                <ul class="tags" aria-label="Skills and tools">
                  {entry.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <slot />
  </div>
</section>

<style>
  .info-frame {
    --ink: var(--info-ink, #14213d);
    --muted: var(--info-muted, #4d5b73);
    --paper: var(--info-bg, #e8ecf1);
    --rule: var(--info-rule, #b4bfcd);
    --accent: var(--info-accent, #0f766e);

    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: var(--frame-min-height, 100dvh);
    scroll-snap-align: start;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--info-font, system-ui, sans-serif);
    line-height: 1.55;
  }

  .inner {
    flex: 1;
    width: 100%;
    max-width: 62rem;
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 5rem) clamp(1.25rem, 5vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 5vh, 3.5rem);
  }

  h2 {
    margin: 0;
    font-family: var(--info-display, Georgia, "Times New Roman", serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .subheading {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
  }

  /* The entries are chronological, so a vertical rail with markers shows the order. */
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--rule);
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: minmax(8rem, 11rem) 1fr;
    gap: 0.5rem 2rem;
    padding: 0 0 clamp(1.5rem, 3vh, 2.25rem) clamp(1.25rem, 3vw, 2rem);
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  .entry::before {
    content: "";
    position: absolute;
    left: -0.4rem;
    top: 0.45rem;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--paper);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  .meta time {
    color: var(--ink);
    font-weight: 600;
  }

  h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .organization {
    margin: 0.1rem 0 0;
    color: var(--accent);
    font-weight: 500;
  }

  .organization a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .organization a:hover {
    text-decoration-thickness: 2px;
  }

  .organization a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .summary {
    margin: 0.6rem 0 0;
    max-width: 65ch;
  }

  .highlights {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    max-width: 65ch;
  }

  .highlights li {
    margin-bottom: 0.25rem;
  }

  .highlights li::marker {
    color: var(--accent);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .entry {
      grid-template-columns: 1fr;
    }
    .meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem 0.75rem;
    }
  }
</style>