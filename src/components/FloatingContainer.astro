---
interface Props {
  header: string;
  subHeader1?: string;
  subHeader2?: string;
  centered?: boolean;
  maxWidth?: string;
}

const {
  header,
  subHeader1,
  subHeader2,
  centered = false,
  maxWidth = '720px',
} = Astro.props;
---

<section
  class:list={['floating-container', { 'is-centered': centered }]}
  style={`--card-max-width: ${maxWidth};`}
>
  <slot name="top" />

  <header class="card-headings">
    <h1 class="header">{header}</h1>
    {subHeader1 && <h2 class="sub-header-primary">{subHeader1}</h2>}
    {subHeader2 && <h3 class="sub-header-secondary">{subHeader2}</h3>}
  </header>

  <div class="card-content">
    <slot name="content" />
    <slot />
  </div>
</section>

<style>
  .floating-container {
    width: 100%;
    max-width: var(--card-max-width, 720px);
    margin: 0 auto;       /* Centers inside block and flex parents */
    justify-self: center; /* Centers inside CSS Grid parents */
    background: #ffffff;
    color: #1e293b;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2.5rem 3rem;
    box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.25);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-sizing: border-box;
  }

  .floating-container.is-centered {
    align-items: center;
    text-align: center;
  }

  .card-headings {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .header {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    color: #0f172a;
  }

  .sub-header-primary {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    color: #2563eb;
  }

  .sub-header-secondary {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    color: #64748b;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #334155;
    flex: 1;
  }

  .card-content :global(p) {
    margin: 0;
  }

  .card-content :global(h4) {
    text-align: left;
    font-size: 1.2rem;
  }

  .card-content :global(h5) {
    text-align: left;
    font-size: 1rem;
  }

  .card-content :global(ul) {
    text-align: left;
    list-style-type: disc;
    padding-left: 2rem;
    margin: 10px 0;
  }

  .card-content :global(p) {
    margin: 0;
    text-align: justify;
  }

  @media (max-width: 640px) {
    .floating-container {
      padding: 2rem 1.5rem;
    }
  }
</style>